# Copy to .env.local and fill in. Everything here is read by the server only;
# nothing reaches the browser except the backend ids.
#
# The Settings page (/settings) can set backends, gallery folders and profile
# defaults too. What it saves (latentry.settings.json) takes precedence; what
# it leaves alone falls back to the values below.

# ── Backends ────────────────────────────────────────────────────────────────
# One entry per backend, separated by ";":   id|kind|url|profile
#   id       what the UI calls it (a-z, 0-9, "-", "_")
#   kind     diffusers  a server speaking the API in docs/backend-api.md
#            a1111      AUTOMATIC1111 or Forge, started with --api
#   url      where it listens
#   profile  generic | sdxl | illustrious | pony | anima  (the form's starting
#            point; it can be changed in the UI at any time)
GEN_BACKENDS=anima|diffusers|http://localhost:7865|anima;sdxl|a1111|http://localhost:7860|illustrious

# Tokens, by backend id in upper case (non-alphanumerics become "_").
#   diffusers: sent as "Authorization: Bearer <token>"
#   a1111:     "user:password", as given to --api-auth
# GEN_TOKEN_ANIMA=
# GEN_TOKEN_SDXL=user:password

# Which backend tags pictures with WD14. Default: the first that can.
# TAGGER_BACKEND=anima
# A1111 / Forge with the WD14 tagger extension: which of its models to use.
# Default: the first one whose name contains "wd".
# A1111_TAGGER_MODEL=wd-v1-4-moat-tagger.v2

# Older single-backend form, still read when GEN_BACKENDS is unset:
# DIFFUSION_SERVER_URL=http://localhost:7865
# DIFFUSION_API_TOKEN=

# ── Gallery ─────────────────────────────────────────────────────────────────
# Where Latentry saves every finished image, with its settings embedded.
# Leave unset to not save (images can still be downloaded one by one).
GALLERY_SAVE_DIR=./output
# Other folders to browse, read-only, separated by ";" (e.g. ComfyUI's or the
# web UI's output folder). These must be on the machine running Latentry.
# GALLERY_DIRS=D:\ComfyUI\output;D:\stable-diffusion-webui\outputs\txt2img-images
# Tag each saved image with WD14 as it arrives (uses the tagger once per image).
# GALLERY_AUTO_TAG=1

# ── Settings page ───────────────────────────────────────────────────────────
# Who may change settings from the browser:
#   local (default)  only on this computer (http://localhost)
#   lan              from any address /api answers
#   off              nobody; edit this file or the settings file by hand
# SETTINGS_EDIT=local
# Where the settings page saves (it holds backend tokens; keep it private).
# LATENTRY_SETTINGS_FILE=./latentry.settings.json

# ── Access ──────────────────────────────────────────────────────────────────
# /api answers only for localhost and private-network addresses. To serve it
# under a hostname (e.g. behind a reverse proxy), list the hostname here.
# ALLOWED_HOSTS=studio.home.arpa

# Per-IP request budget (per minute). REQUEST_BUDGET=off turns it off.
# REQUEST_BUDGET_PAGE_PER_MIN=120
# REQUEST_BUDGET_API_PER_MIN=300
# REQUEST_BUDGET_POST_PER_MIN=30
# REQUEST_BUDGET_GLOBAL_PER_MIN=1200
# REQUEST_BUDGET_SSE_PER_IP=12
