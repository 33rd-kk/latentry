{
  "name": "latentry",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "node scripts/serve.mjs build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-verify.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:check": "node scripts/i18n-translate.mjs --check",
    "engine:lock": "node scripts/lock-engine.mjs",
    "banner": "node scripts/make-banner.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "owner-code": "node scripts/owner-code.mjs",
    "forget-devices": "node scripts/forget-devices.mjs",
    "coverage": "c8 node scripts/run-verify.mjs && node -e \"require('fs').rmSync('coverage/tmp', { recursive: true, force: true })\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "onnxruntime-node": "^1.30.0",
    "panorail": "github:33rd-kk/panorail#v0.3.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-compare-slider": "^4.0.0",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "c8": "^12.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3"
  },
  "description": "Private, local image generation. Every picture remembered. A web UI for your own diffusion backends: text-to-image, img2img, inpaint, poses from group pictures turned in 3D, a gallery that knows how each picture was made, and WD14 tagging.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/33rd-kk/latentry.git"
  },
  "homepage": "https://github.com/33rd-kk/latentry#readme",
  "bugs": {
    "url": "https://github.com/33rd-kk/latentry/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
